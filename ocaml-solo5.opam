opam-version: "2.0"
maintainer: "Martin Lucina <martin@lucina.net>"
authors: "Martin Lucina <martin@lucina.net>"
homepage: "https://github.com/mirage/ocaml-solo5"
bug-reports: "https://github.com/mirage/ocaml-solo5/issues/"
license: "MIT"
tags: "org:mirage"
dev-repo: "git+https://github.com/mirage/ocaml-solo5.git"
build: [
  ["./configure.sh"
   "--prefix=%{prefix}%"
   "--target=x86_64-solo5-none-static" { arch = "x86_64" }
   "--target=aarch64-solo5-none-static" { arch = "arm64" }
   # macOS only, added with the macOS clang toolchain support (see the
   # comment below): configure consults this only if the C99 float-op checks
   # fail, turning that error into emulated float ops. They pass today.
   "--ocaml-configure-option=--enable-imprecise-c99-float-ops" { os = "macos" }
   # macOS only: the toolchain wrapper there drives clang + ld.lld rather
   # than a GCC/binutils toolchain. With the clang vendor that OCaml's
   # configure detects, it would enable function sections here
   # (-ffunction-sections for C, -function-sections for native OCaml). OCaml
   # treats function sections as unsupported on Darwin and its configure
   # refuses them for *-apple-darwin* targets, but that guard matches the
   # target triple (canonicalized to aarch64-unknown-none here, not the
   # darwin host), so it never fires and the flag must be passed explicitly.
   "--ocaml-configure-option=--disable-function-sections" { os = "macos" }
   "--ocaml-configure-option=--disable-flat-float-array" {ocaml-option-no-flat-float-array:installed}
   "--ocaml-configure-option=--enable-flambda" {ocaml-option-flambda:installed}
  ]
  [make "-j%{jobs}%"]
  [make "%{name}%.install"]
]
install: [
  [make "install-ocaml"]
]
depopts: [
  "ocaml-option-no-flat-float-array"
  "ocaml-option-flambda"
]
run-test: [
  [make "test"]
]
depends: [
  "opatch" {build} # to patch the compiler sources
  "ocamlfind" {build}
  "ocaml-src" {build}
  "ocaml" {>= "5.5" & < "5.6"}
  "solo5" {>= "0.9.1"}
]
conflicts: [
  "sexplib" {= "v0.9.0"}
  "solo5-kernel-ukvm"
  "solo5-kernel-virtio"
  "solo5-kernel-muen"
]
available: [
  ((os = "linux" & (arch = "x86_64" | arch = "arm64"))
  | (os = "freebsd" & arch = "x86_64")
  | (os = "openbsd" & arch = "x86_64")
  | (os = "dragonfly" & arch = "x86_64")
  | (os = "macos" & arch = "arm64"))
]
x-maintenance-intent: [ "(latest)" ]
synopsis: "OCaml cross-compiler to the freestanding Solo5 backend"
description:
  "This package provides a OCaml cross-compiler, suitable for linking with a Solo5 unikernel."
